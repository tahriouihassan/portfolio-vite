---
/**
 * Resume for recruiters and hiring managers. Plain, single-column HTML so it
 * parses well in ATS tools. The print styles below also produce the
 * downloadable PDF (npm run resume:pdf). Built from the same data as About.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE, SOCIALS } from "../consts";
import { EXPERIENCE, SKILLS } from "../data/experience";

const linkedin = SOCIALS.find((s) => s.icon === "linkedin")!;
const github = SOCIALS.find((s) => s.icon === "github")!;
const upwork = SOCIALS.find((s) => s.icon === "upwork")!;
const shortUrl = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");

const projects = [
  {
    name: "Tracefox",
    href: `${SITE.url}/projects/tracefox/`,
    text: "Live SaaS for automated checkout testing, built solo: scheduled real-browser runs, step-level failure reports, agency workspaces and paid plans.",
  },
  {
    name: "VisitFootball group",
    href: `${SITE.url}/projects/visitfootball/`,
    text: "Multi-brand ticketing and travel platforms: shared Next.js codebase, Strapi backends, checkout and payments, multilingual SEO and order automation.",
  },
  {
    name: "OpenMatch (2022)",
    href: `${SITE.url}/projects/openmatch/`,
    text: "Two-sided job platform with AI-assisted resume building, job matching, recruiter tools and Stripe subscriptions (Nuxt, Vue).",
  },
  {
    name: "L'Moniteur",
    href: "https://lmoniteur.ma",
    text: "Booking platform connecting learner drivers with driving instructors across Morocco (Laravel, Flutter).",
  },
  {
    name: "7eco24",
    text: "High-volume classifieds site with 400k+ ads (Laravel).",
  },
  {
    name: "Momentoo",
    text: "Focus app that reached 2nd Product of the Day on Product Hunt (Vue).",
  },
];
---

<BaseLayout
  title="Resume: Technical Lead & Senior Full-Stack Engineer"
  description="Resume of Hassan Tahrioui: technical lead and senior full-stack engineer, 9+ years in Laravel, Next.js and Node, based in Morocco and working remotely with European teams."
  alternate={null}
>
  <article class="resume mx-auto flex max-w-3xl flex-col gap-10" lang="en">
    <header class="flex flex-col gap-4">
      <div class="no-print flex flex-wrap gap-3">
        <a
          href={SITE.resumePdf}
          download
          data-event="resume_pdf_download"
          data-event-label="resume_page"
          class="inline-flex items-center gap-2 rounded-md border border-accent bg-accent px-4 py-2.5 font-theme_bold text-sm text-white transition hover:brightness-110"
        >
          <Icon name="download" size={18} /> Download PDF
        </a>
        <a
          href="/contact/?topic=role"
          class="inline-flex items-center gap-2 rounded-md border border-link_border bg-btn_back px-4 py-2.5 font-theme_bold text-sm text-btn_text transition-colors hover:bg-item_hover_back"
        >
          <Icon name="mail" size={18} /> Get in touch
        </a>
      </div>
      <h1 class="font-theme_bold text-3xl text-head_text sm:text-4xl">{SITE.name}</h1>
      <p class="font-theme_bold text-lg text-link_text_hover">Technical Lead · Senior Full-Stack Engineer</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
        <li>Morocco · Remote (CET-aligned)</li>
        <li><a href={`mailto:${SITE.email}`} class="hover:text-head_text">{SITE.email}</a></li>
        <!-- Full addresses, not just names, so they still work on a printed page. -->
        <li><a href={`${SITE.url}/`} class="hover:text-head_text">{shortUrl(SITE.url)}</a></li>
        <li><a href={linkedin.url} class="hover:text-head_text">{shortUrl(linkedin.url)}</a></li>
        <li><a href={github.url} class="hover:text-head_text">{shortUrl(github.url)}</a></li>
      </ul>
    </header>

    <section class="flex flex-col gap-3" aria-labelledby="r-summary">
      <h2 id="r-summary" class="resume-h2">Summary</h2>
      <p class="text-base leading-relaxed">
        Technical lead and senior full-stack engineer with 9+ years building commercial web software in Laravel, Next.js
        and Node. Since 2021, lead developer for a group of four football ticketing and travel brands, responsible for
        technical direction, releases and production across shared Next.js and Strapi platforms with live payments and
        multilingual SEO. Founder of Tracefox, a live checkout-testing SaaS I built solo. Open to the right long-term
        role with a remote-first product team.
      </p>
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="r-experience">
      <h2 id="r-experience" class="resume-h2">Experience</h2>
      {
        EXPERIENCE.map((r) => (
          <div class="resume-item flex flex-col gap-1.5 py-3">
            <div class="flex flex-col justify-between gap-x-4 sm:flex-row sm:items-baseline">
              <h3 class="font-theme_bold text-base text-head_text">
                {r.role.en}, {r.company}
              </h3>
              <span class="shrink-0 font-theme text-sm text-p_text">{r.period.en}</span>
            </div>
            {r.detail && <p class="text-sm text-p_text">{r.detail}</p>}
            {r.bullets && (
              <ul class="flex list-disc flex-col gap-1 pl-5 text-sm leading-relaxed">
                {r.bullets.en.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="r-projects">
      <h2 id="r-projects" class="resume-h2">Selected projects</h2>
      <ul class="flex flex-col gap-2 text-sm leading-relaxed">
        {
          projects.map((p) => (
            <li>
              {/* prettier-ignore */}
              <strong class="font-theme_bold text-head_text">{p.href ? <a href={p.href} class="hover:text-link_text_hover">{p.name}</a> : p.name}</strong>{`: ${p.text}`}
            </li>
          ))
        }
      </ul>
      <p class="text-sm">
        Freelance: 100% Job Success Score on <a href={upwork.url} class="underline underline-offset-2 hover:text-head_text">Upwork</a>.
      </p>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="r-skills">
      <h2 id="r-skills" class="resume-h2">Skills</h2>
      <dl class="flex flex-col gap-2 text-sm">
        {
          SKILLS.map((s) => (
            <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-3">
              <dt class="w-48 shrink-0 font-theme_bold text-head_text">{s.group.en}</dt>
              <dd>{s.items.join(", ")}</dd>
            </div>
          ))
        }
        <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-3">
          <dt class="w-48 shrink-0 font-theme_bold text-head_text">Languages</dt>
          <dd>Arabic (native), English (fluent), French (fluent)</dd>
        </div>
      </dl>
    </section>
  </article>
</BaseLayout>

<style is:global>
  .resume-h2 {
    @apply border-b border-border_sm pb-2 font-theme_bold text-sm uppercase tracking-widest text-link_text_hover;
  }

  @media print {
    @page {
      size: A4;
      margin: 13mm 14mm;
    }
    body {
      background: #fff !important;
      color: #111 !important;
      font-size: 10pt;
    }
    /* One plain sans face in print: the mono heading font's ligatures make
       Chrome split words into fragments ("Ha ss a n") in the PDF text layer,
       which ATS parsers then misread. */
    .resume,
    .resume * {
      font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif !important;
    }
    .resume h1,
    .resume h3,
    .resume strong,
    .resume dt,
    .resume-h2,
    .resume header p {
      font-weight: 700 !important;
    }
    .resume h1 {
      font-size: 22pt !important;
      line-height: 1.1 !important;
    }
    .resume header {
      gap: 6px !important;
    }
    .resume section {
      break-inside: auto;
    }
    .resume-h2 {
      break-after: avoid;
    }
    body > nav,
    body > footer,
    body > a[href="#main"],
    .no-print {
      display: none !important;
    }
    main {
      margin: 0 !important;
      padding: 0 !important;
      max-width: none !important;
    }
    .resume {
      gap: 14px !important;
      max-width: none !important;
    }
    .resume *,
    .resume a {
      color: #111 !important;
    }
    .resume-h2 {
      color: #3730a3 !important;
      border-color: #ccc !important;
    }
    .resume-item {
      break-inside: avoid;
      padding: 4px 0 !important;
    }
    .reveal-init {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
