---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import Icon from "../components/Icon.astro";
import { ui } from "../i18n";

// One static 404 serves both locales, so it shows both languages.
const en = ui.en.notFound;
const fr = ui.fr.notFound;
---

<BaseLayout title={en.title} noindex={true}>
  <div class="flex flex-col gap-6">
    <h1 class="font-theme_bold text-7xl text-head_text sm:text-8xl">404</h1>
    <p class="max-w-lg text-lg leading-relaxed">{en.body}</p>
    <p class="max-w-lg text-base leading-relaxed text-p_text" lang="fr">{fr.body}</p>
    <div class="flex flex-wrap gap-3">
      <ActionButton link="/" variant="primary">
        <Icon name="arrow-right" size={18} class="rotate-180" />{en.home}
      </ActionButton>
      <ActionButton link="/projects/">{en.work}</ActionButton>
      <ActionButton link="/fr/">
        <span lang="fr">{fr.home}</span>
      </ActionButton>
    </div>
  </div>
</BaseLayout>
