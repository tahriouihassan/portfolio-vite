---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectRow from "../components/ProjectRow.astro";
import CtaSection from "../components/CtaSection.astro";
import { getLocale, ui } from "../i18n";

const locale = getLocale(Astro.url);
const t = ui[locale];
const pp = t.projectsPage;

const all = await getCollection("projects");
const byOrder = (a: (typeof all)[number], b: (typeof all)[number]) => a.data.order - b.data.order;
const active = all.filter((p) => p.data.status === "active").sort(byOrder);
// Flagship work (anything with a written case study) gets large visual cards;
// everything else is a compact list, so placeholders never compete with it.
const caseStudies = active.filter((p) => p.body.trim().length > 0);
const [flagship, ...otherCases] = caseStudies;
const more = active.filter((p) => p.body.trim().length === 0);
const archived = all.filter((p) => p.data.status === "archived").sort(byOrder);
---

<BaseLayout title={t.meta.projects.title} description={t.meta.projects.description}>
  <div class="flex flex-col gap-16 slg:gap-24">
    <section class="flex flex-col gap-5">
      <SectionHeading as="h1" title={pp.h1} />
      <p class="max-w-3xl text-base leading-relaxed slg:text-lg">{pp.intro}</p>
    </section>

    <section class="flex flex-col gap-8" aria-labelledby="case-studies">
      <SectionHeading id="case-studies" title={pp.caseStudiesHeading} sub={pp.caseStudiesSub} />
      {flagship && <ProjectCard project={flagship} wide />}
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {otherCases.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    {
      more.length > 0 && (
        <section class="flex flex-col gap-6" aria-labelledby="more-work">
          <SectionHeading id="more-work" title={pp.moreHeading} sub={pp.moreSub} />
          <ul class="flex flex-col border-b border-border_sm">
            {more.map((p) => <ProjectRow project={p} />)}
          </ul>
        </section>
      )
    }

    {
      archived.length > 0 && (
        <section class="flex flex-col gap-6" aria-labelledby="earlier">
          <SectionHeading id="earlier" title={pp.earlierHeading} sub={pp.earlierSub} />
          <ul class="flex flex-col border-b border-border_sm">
            {archived.map((p) => <ProjectRow project={p} />)}
          </ul>
        </section>
      )
    }

    <CtaSection />
  </div>
</BaseLayout>
