---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectImage from "../components/ProjectImage.astro";
import ActionButton from "../components/ActionButton.astro";
import StageBadge from "../components/StageBadge.astro";
import CtaSection from "../components/CtaSection.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../consts";
import { getLocale, ui, localizePath, resolveProject } from "../i18n";

export interface Neighbor {
  slug: string;
  title: string;
}

interface Props {
  project: CollectionEntry<"projects">;
  /** French body + meta, when this case study has a translation. */
  fr?: CollectionEntry<"projects-fr">;
  prev: Neighbor | null;
  next: Neighbor | null;
}

const { project, fr, prev, next } = Astro.props;
const locale = getLocale(Astro.url);
const t = ui[locale];
const c = t.caseStudy;
const { data, slug } = project;
const p = resolveProject(data, locale);
const entry = locale === "fr" && fr ? fr : project;
const { Content } = await entry.render();

const seoTitle = locale === "fr" && fr ? fr.data.seoTitle : data.seoTitle ?? data.title;
const description = locale === "fr" && fr ? fr.data.description : data.description;
const imageAlt = (locale === "fr" ? data.fr?.imageAlt : undefined) ?? data.imageAlt;
const domain = data.link ? new URL(data.link).hostname.replace(/^www\./, "") : null;
const pathFor = (s: string) => localizePath(`/projects/${s}`, locale);
const alternate = fr ? { en: `/projects/${slug}/`, fr: `/fr/projects/${slug}/` } : null;

const meta = [
  { label: c.role, value: p.role },
  { label: c.period, value: p.year },
  { label: c.client, value: data.client },
].filter((m) => m.value);

const home = locale === "fr" ? "Accueil" : "Home";
const pageUrl = new URL(pathFor(slug), SITE.url).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: home, item: new URL(localizePath("/", locale), SITE.url).href },
        { "@type": "ListItem", position: 2, name: t.nav[0].label, item: new URL(localizePath("/projects", locale), SITE.url).href },
        { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
      ],
    },
    {
      "@type": "Article",
      headline: seoTitle,
      description,
      inLanguage: locale,
      url: pageUrl,
      author: { "@id": `${SITE.url}/#person` },
      ...(data.image ? { image: new URL(data.image.src, SITE.url).href } : {}),
    },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={description}
  image={data.image?.src}
  imageAlt={imageAlt}
  article={true}
  alternate={alternate}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="flex flex-col gap-10">
    <nav aria-label="Breadcrumb" class="text-sm">
      <a href={localizePath("/projects", locale)} class="inline-flex w-fit items-center gap-1 text-p_text transition-colors hover:text-head_text">
        <Icon name="arrow-right" size={16} class="rotate-180" />
        {c.back}
      </a>
    </nav>

    <header class="flex flex-col gap-5">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-theme_bold text-3xl text-head_text sm:text-4xl slg:text-5xl">{data.title}</h1>
        <StageBadge stage={data.stage} />
      </div>
      {p.outcome && <p class="max-w-3xl text-lg leading-relaxed text-action_text slg:text-xl">{p.outcome}</p>}

      {
        meta.length > 0 && (
          <dl class="grid grid-cols-1 gap-4 border-y border-border_sm py-5 sm:grid-cols-3">
            {meta.map((m) => (
              <div class="flex flex-col gap-1">
                <dt class="kicker">{m.label}</dt>
                <dd class="text-sm text-head_text">{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        data.tech.length > 0 && (
          <ul class="flex flex-wrap gap-1.5" aria-label={c.stack}>
            {data.tech.map((x) => (
              <li class="chip">{x}</li>
            ))}
          </ul>
        )
      }
      <div class="flex flex-wrap gap-3 pt-1">
        {
          data.link && (
            <ActionButton link={data.link} event="project_site_click" eventLabel={slug}>
              {`${t.visit} ${domain}`}
              <Icon name="arrow-up-right" size={18} />
            </ActionButton>
          )
        }
        {
          data.repo && (
            <ActionButton link={data.repo}>
              <Icon name="github" size={18} />{c.source}
            </ActionButton>
          )
        }
      </div>
    </header>

    {
      data.image && (
        <ProjectImage
          image={data.image}
          title={data.title}
          alt={imageAlt}
          class="aspect-video"
          eager
          sizes="(max-width: 1024px) 100vw, 860px"
        />
      )
    }

    <div class="case-study-body max-w-3xl">
      <Content />
    </div>

    {
      (prev || next) && (
        <nav
          class="flex flex-col gap-4 border-t border-border_sm pt-8 sm:flex-row sm:justify-between"
          aria-label={locale === "fr" ? "Autres études de cas" : "More case studies"}
        >
          {prev ? (
            <a href={pathFor(prev.slug)} class="group flex items-center gap-2 font-theme_bold text-sm text-p_text transition-colors hover:text-head_text">
              <Icon name="arrow-right" size={16} class="rotate-180 transition-transform group-hover:-translate-x-1" />
              <span>
                <span class="block font-theme text-xs text-p_text">{c.prev}</span>
                {prev.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={pathFor(next.slug)} class="group flex items-center gap-2 text-right font-theme_bold text-sm text-p_text transition-colors hover:text-head_text sm:ml-auto">
              <span>
                <span class="block font-theme text-xs text-p_text">{c.next}</span>
                {next.title}
              </span>
              <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
            </a>
          )}
        </nav>
      )
    }

    <CtaSection heading={c.ctaHeading} sub={c.ctaSub} />
  </article>
</BaseLayout>
