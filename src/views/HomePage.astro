---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CtaSection from "../components/CtaSection.astro";
import ActionButton from "../components/ActionButton.astro";
import LinkBtn from "../components/LinkBtn.astro";
import Icon from "../components/Icon.astro";
import { CONTACT, SITE, SOCIALS } from "../consts";
import { getLocale, ui, localizePath } from "../i18n";
import { EXPERIENCE } from "../data/experience";

const locale = getLocale(Astro.url);
const t = ui[locale];
const upworkUrl = SOCIALS.find((s) => s.icon === "upwork")?.url;

const [flagship, ...featured] = (await getCollection("projects"))
  .filter((p) => p.data.featured && p.data.status === "active")
  .sort((a, b) => a.data.order - b.data.order);
const testimonials = (await getCollection("testimonials"))
  .filter((r) => r.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// The two current roles get full rows; earlier roles collapse into one line.
const current = EXPERIENCE.slice(0, 2);
const earlier = EXPERIENCE.slice(2);
const earlierYears = earlier.flatMap((r) => r.period.en.match(/\d{4}/g) ?? []).map(Number);
const earlierSpan = earlierYears.length ? `${Math.min(...earlierYears)} – ${Math.max(...earlierYears)}` : "";
const earlierCompanies = new Intl.ListFormat(locale, { type: "conjunction" }).format(earlier.map((r) => r.company));
---

<BaseLayout title={t.meta.home.title || undefined} description={t.meta.home.description}>
  <div class="flex flex-col gap-20 slg:gap-28">
    <Hero />

    <!-- OWNERSHIP: what I'm accountable for, not a tech list -->
    <section class="flex flex-col gap-8" aria-labelledby="ownership">
      <SectionHeading id="ownership" title={t.ownership.heading} sub={t.ownership.sub} />
      <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-border_sm bg-border_sm md:grid-cols-2">
        {
          t.ownership.items.map((item) => (
            <div class="flex flex-col gap-3 bg-item_back p-6 slg:p-7">
              <div class="flex items-center gap-3">
                <span class="text-link_text_hover">
                  <Icon name={item.icon} size={20} />
                </span>
                <h3 class="font-theme_bold text-base text-head_text slg:text-lg">{item.title}</h3>
              </div>
              <p class="text-sm leading-relaxed slg:text-base">{item.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section class="flex flex-col gap-8" aria-labelledby="work">
      <SectionHeading id="work" title={t.work.heading} sub={t.work.sub} />
      {flagship && <ProjectCard project={flagship} wide />}
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
      <a
        href={localizePath("/projects", locale)}
        class="inline-flex w-fit items-center gap-1 font-theme_bold text-sm text-link_text_hover underline-offset-4 hover:underline"
      >
        {t.work.all} <Icon name="arrow-right" size={16} />
      </a>
    </section>

    <!-- EXPERIENCE: the 30-second recruiter scan -->
    <section class="flex flex-col gap-8" aria-labelledby="experience">
      <SectionHeading id="experience" title={t.experience.heading} sub={t.experience.sub} />
      <ol class="flex flex-col">
        {
          current.map((r) => (
            <li class="grid grid-cols-1 gap-1 border-t border-border_sm py-5 sm:grid-cols-[11rem_1fr] sm:gap-8">
              <span class="font-theme text-sm text-p_text">{r.period[locale]}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-theme_bold text-base text-head_text slg:text-lg">
                  {r.href ? (
                    <a href={localizePath(r.href, locale)} class="hover:text-link_text_hover">
                      {r.company}
                    </a>
                  ) : (
                    r.company
                  )}
                  <span class="font-theme text-p_text"> · {r.role[locale]}</span>
                </h3>
                {r.detail && <p class="font-theme text-xs text-p_text">{r.detail}</p>}
                {r.bullets && <p class="mt-1 max-w-3xl text-sm leading-relaxed slg:text-base">{r.bullets[locale][0]}</p>}
              </div>
            </li>
          ))
        }
        {
          earlier.length > 0 && (
            <li class="grid grid-cols-1 gap-1 border-y border-border_sm py-5 sm:grid-cols-[11rem_1fr] sm:gap-8">
              <span class="font-theme text-sm text-p_text">{earlierSpan}</span>
              <p class="text-sm leading-relaxed slg:text-base">
                <span class="font-theme_bold text-head_text">{t.experience.earlier}: </span>
                {t.experience.earlierRole} {earlierCompanies}.
              </p>
            </li>
          )
        }
      </ol>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <ActionButton link={t.resumeHref} variant="primary" event="resume_click" eventLabel="home_experience">
          {t.experience.cta} <Icon name="arrow-right" size={18} />
        </ActionButton>
        <a
          href={SITE.resumePdf}
          download
          data-event="resume_pdf_download"
          data-event-label="home_experience"
          class="inline-flex items-center gap-2 rounded-md border border-link_border bg-btn_back px-4 py-2.5 font-theme_bold text-sm text-btn_text transition-colors hover:bg-item_hover_back slg:px-5 slg:py-3 slg:text-base"
        >
          <Icon name="download" size={18} />{t.experience.pdf}
        </a>
        <ActionButton link={`${localizePath("/about", locale)}#experience`} variant="ghost">
          {t.experience.secondary} <Icon name="arrow-right" size={16} />
        </ActionButton>
      </div>
    </section>

    <!-- TWO PATHS: employers and clients -->
    <section class="flex flex-col gap-8" aria-labelledby="paths">
      <SectionHeading id="paths" title={t.paths.heading} />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="flex flex-col gap-4 rounded-lg border border-border_sm bg-item_back p-6 slg:p-8">
          <span class="kicker flex items-center gap-2"><Icon name="briefcase" size={16} />{t.paths.employer.kicker}</span>
          <h3 class="font-theme_bold text-xl text-head_text">{t.paths.employer.title}</h3>
          <p class="text-sm leading-relaxed slg:text-base">{t.paths.employer.body}</p>
          <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-2">
            <ActionButton link={t.resumeHref} variant="primary" event="resume_click" eventLabel="home_path">
              {t.paths.employer.cta} <Icon name="arrow-right" size={18} />
            </ActionButton>
            <ActionButton link={t.paths.employer.secondaryHref} variant="ghost">
              {t.paths.employer.secondary} <Icon name="arrow-right" size={16} />
            </ActionButton>
          </div>
        </div>
        <div class="flex flex-col gap-4 rounded-lg border border-border_sm bg-item_back p-6 slg:p-8">
          <span class="kicker flex items-center gap-2"><Icon name="layers" size={16} />{t.paths.client.kicker}</span>
          <h3 class="font-theme_bold text-xl text-head_text">{t.paths.client.title}</h3>
          <p class="text-sm leading-relaxed slg:text-base">{t.paths.client.body}</p>
          <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-2">
            <ActionButton link={localizePath("/services", locale)} variant="primary" event="services_click" eventLabel="home_path">
              {t.paths.client.cta} <Icon name="arrow-right" size={18} />
            </ActionButton>
            <ActionButton link={CONTACT.bookingUrl} variant="ghost" event="book_call_click" eventLabel="home_path">
              <Icon name="calendar" size={16} />{t.paths.client.secondary}
            </ActionButton>
          </div>
        </div>
      </div>
    </section>

    {
      testimonials.length > 0 && (
        <section class="flex flex-col gap-8" aria-labelledby="reviews">
          <div class="flex flex-col gap-3">
            <SectionHeading id="reviews" title={t.reviews.heading} />
            {upworkUrl && (
              <p class="max-w-2xl text-base leading-relaxed">
                {t.reviews.subBefore} <LinkBtn link={upworkUrl}>{t.reviews.subLink}</LinkBtn>{t.reviews.subAfter}
              </p>
            )}
          </div>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {testimonials.map((r) => (
              <TestimonialCard {...r.data} />
            ))}
          </div>
        </section>
      )
    }

    <CtaSection />
  </div>
</BaseLayout>
