---
interface Props {
  link: string;
  variant?: "default" | "primary" | "ghost";
  external?: boolean;
  class?: string;
  /** GA event name sent on click (see BaseLayout). */
  event?: string;
  eventLabel?: string;
}
const { link, variant = "default", external, class: className = "", event, eventLabel } = Astro.props;

const isExternal = external ?? /^https?:\/\//.test(link);
const rel = isExternal ? "noopener noreferrer" : undefined;
const target = isExternal ? "_blank" : undefined;

const base =
  "inline-flex items-center gap-2 rounded-md font-theme_bold text-sm transition-colors px-4 py-2.5 slg:text-base slg:px-5 slg:py-3 w-fit border";
const variants = {
  default: "bg-btn_back border-link_border text-btn_text hover:bg-item_hover_back",
  primary: "bg-accent border-accent text-white hover:brightness-110",
  ghost: "border-transparent px-0 text-link_text_hover hover:text-head_text slg:px-0",
};
---

<a
  href={link}
  target={target}
  rel={rel}
  data-event={event}
  data-event-label={eventLabel}
  class:list={[base, variants[variant], className]}
>
  <slot />
</a>
