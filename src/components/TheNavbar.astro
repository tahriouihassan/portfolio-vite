---
import Icon from "./Icon.astro";
import { SITE } from "../consts";
import { getLocale, alternates, ui } from "../i18n";

interface Props {
  /** Language-switch target when the page has a translation outside TRANSLATED. */
  alternate?: { en: string; fr: string } | null;
}

const locale = getLocale(Astro.url);
const t = ui[locale];
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, "") || "/";
  return path === h || path.startsWith(h + "/");
};

// Language switcher: link to this page's translation, or the other locale's home.
const alt = Astro.props.alternate ?? alternates(Astro.url.pathname);
const switchHref = locale === "en" ? alt?.fr ?? "/fr/" : alt?.en ?? "/";
const homeHref = locale === "fr" ? "/fr/" : "/";
---

<nav
  aria-label={locale === "fr" ? "Navigation principale" : "Main"}
  class="fixed bottom-0 z-40 flex w-full items-center justify-between border-t border-border_sm bg-navbar_back px-3 py-2.5 backdrop-blur-sm sm:bottom-auto sm:top-0 sm:border-b sm:border-t-0 sm:px-6 lg:py-4"
>
  <div class="absolute left-0 top-0 h-[1px] w-full bg-topbar lg:h-1"></div>

  <a
    href={homeHref}
    class="select-none font-logo text-2xl font-normal sm:text-3xl slg:font-semibold lg:text-4xl"
    aria-label={`${SITE.name}, ${locale === "fr" ? "accueil" : "home"}`}
  >
    <!-- Narrow phones get the monogram so the bottom bar never overflows. -->
    <span class="min-[440px]:hidden" aria-hidden="true">{SITE.logo.charAt(0)}</span>
    <span class="hidden min-[440px]:inline" aria-hidden="true">{SITE.logo}</span>
  </a>

  <div class="flex items-center gap-0.5 text-[12px] min-[440px]:text-[13px] sm:gap-2 sm:text-sm lg:text-base">
    {
      t.nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class="whitespace-nowrap rounded-md px-1.5 py-2 font-theme_bold transition-all hover:bg-action_back min-[440px]:px-2 sm:px-4"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={t.contactHref}
      aria-current={isActive(t.contactHref) ? "page" : undefined}
      data-event="nav_contact_click"
      class="ml-1 inline-flex items-center rounded-md border border-accent bg-accent px-2 py-2 font-theme_bold text-white transition-colors hover:brightness-110 min-[440px]:px-2.5 sm:px-4"
    >
      <!-- Icon-only on narrow phones; the label stays available to screen readers. -->
      <Icon name="mail" size={16} class="min-[440px]:hidden" />
      <span class="sr-only min-[440px]:not-sr-only">{t.navCta}</span>
    </a>
    <a
      href={switchHref}
      hreflang={locale === "en" ? "fr" : "en"}
      lang={locale === "en" ? "fr" : "en"}
      class="ml-1 rounded-md border border-border_sm px-2 py-2 font-theme_bold text-p_text transition-colors hover:bg-action_back hover:text-head_text sm:px-3"
      aria-label={t.langSwitch.aria}
    >
      {t.langSwitch.label}
    </a>
  </div>
</nav>
