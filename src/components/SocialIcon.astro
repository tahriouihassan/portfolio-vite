---
import Icon from "./Icon.astro";
interface Props {
  title: string;
  link: string;
  icon: string;
  size?: number;
}
const { title, link, icon, size = 22 } = Astro.props;
---

<a
  href={link}
  title={title}
  aria-label={title}
  target="_blank"
  rel="me noopener noreferrer"
  class="inline-flex rounded-md p-2.5 text-p_text transition-all hover:bg-border_sm hover:text-head_text"
>
  <Icon name={icon} size={size} />
</a>
