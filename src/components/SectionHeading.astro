---
interface Props {
  title: string;
  sub?: string;
  id?: string;
  /** Heading level; sections inside a page use h2. */
  as?: "h1" | "h2";
}
const { title, sub, id, as: Tag = "h2" } = Astro.props;
---

<div class="flex flex-col gap-3">
  <Tag
    id={id}
    class:list={[
      "text-balance font-theme_bold tracking-tight text-head_text",
      Tag === "h1" ? "text-3xl leading-tight sm:text-4xl slg:text-[2.75rem]" : "text-2xl slg:text-3xl",
    ]}
  >
    {title}<span class="text-link_text_hover" aria-hidden="true">.</span>
  </Tag>
  {sub && <p class="max-w-2xl text-base leading-relaxed slg:text-lg">{sub}</p>}
</div>
