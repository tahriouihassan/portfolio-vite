---
import ActionButton from "./ActionButton.astro";
import Icon from "./Icon.astro";
import { CONTACT, SOCIALS } from "../consts";
import { getLocale, ui, localizePath } from "../i18n";

const locale = getLocale(Astro.url);
const t = ui[locale];
const h = t.hero;
const profiles = SOCIALS.filter((s) => s.primary);
// Real, checkable names; each links to the case study that explains the role.
const platforms = [
  { name: "VisitFootball", href: "/projects/visitfootball" },
  { name: "Voetbaltrips", href: "/projects/visitfootball" },
  { name: "Voetbaltickets.nl", href: "/projects/visitfootball" },
  { name: "TrustedSeats", href: "/projects/visitfootball" },
  { name: "Tracefox", href: "/projects/tracefox" },
];
---

<section class="relative flex flex-col gap-7" aria-labelledby="hero-title">
  <!-- Subtle brand glow behind the hero (desktop only: on phones it would sit past the screen edge) -->
  <div
    class="pointer-events-none absolute -left-40 -top-44 hidden h-[420px] w-[420px] rounded-full opacity-70 blur-2xl md:block"
    style="background: radial-gradient(closest-side, rgba(99,102,241,0.14), transparent);"
    aria-hidden="true"
  >
  </div>

  <p class="kicker">{h.eyebrow}</p>

  <h1
    id="hero-title"
    class="max-w-4xl text-balance font-theme_bold text-[1.75rem] leading-tight text-head_text sm:text-4xl slg:text-[2.75rem] slg:leading-[1.15]"
  >
    {h.h1}
  </h1>

  <p class="max-w-3xl text-base leading-relaxed slg:text-lg slg:leading-relaxed" set:html={h.leadHtml} />

  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-3">
      <ActionButton link={CONTACT.bookingUrl} variant="primary" event="book_call_click" eventLabel="hero">
        <Icon name="calendar" size={18} />{h.ctaPrimary}
      </ActionButton>
      <ActionButton link={localizePath("/projects", locale)} event="case_studies_click" eventLabel="hero">
        {h.ctaSecondary} <Icon name="arrow-right" size={18} />
      </ActionButton>
    </div>
    <p class="text-sm">
      {h.hiring}
      <a
        href={t.resumeHref}
        data-event="resume_click"
        data-event-label="hero"
        class="ml-1 inline-flex items-center gap-1 font-theme_bold text-link_text_hover underline-offset-4 hover:underline"
      >
        {h.hiringLink} <Icon name="arrow-right" size={14} />
      </a>
    </p>
  </div>

  <dl class="mt-2 grid grid-cols-1 gap-x-6 gap-y-4 border-t border-border_sm pt-6 sm:grid-cols-2 slg:grid-cols-4">
    {
      h.facts.map((s) => (
        <div class="flex flex-col gap-1">
          <dt class="font-theme_bold text-base text-head_text slg:text-lg">{s.value}</dt>
          <dd class="text-sm leading-snug text-p_text">{s.label}</dd>
        </div>
      ))
    }
  </dl>

  <div class="flex flex-col gap-2">
    <p class="font-theme text-xs uppercase tracking-widest text-p_text">{h.platforms}</p>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
      {
        platforms.map((pl) => (
          <li>
            <a
              href={localizePath(pl.href, locale)}
              data-event="case_study_click"
              data-event-label={`hero_platform:${pl.name}`}
              class="font-theme_bold text-sm text-action_text transition-colors hover:text-link_text_hover slg:text-base"
            >
              {pl.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="-ml-2.5 flex items-center gap-1" aria-label={locale === "fr" ? "Profils" : "Profiles"}>
    {
      profiles.map((s) => (
        <li>
          <a
            href={s.url}
            target="_blank"
            rel="me noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md px-2.5 py-2 text-sm text-p_text transition-colors hover:bg-border_sm hover:text-head_text"
          >
            <Icon name={s.icon} size={18} />
            {s.name}
          </a>
        </li>
      ))
    }
  </ul>
</section>
