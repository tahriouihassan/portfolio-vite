---
import ActionButton from "./ActionButton.astro";
import Icon from "./Icon.astro";
import { CONTACT, SITE, SOCIALS } from "../consts";
import { getLocale, ui, localizePath } from "../i18n";

const locale = getLocale(Astro.url);
const t = ui[locale];
const h = t.hero;
const profiles = SOCIALS.filter((s) => s.primary);
// Real, checkable names; each links to the case study that explains the role.
const platforms = [
  { name: "VisitFootball", href: "/projects/visitfootball" },
  { name: "Voetbaltrips", href: "/projects/visitfootball" },
  { name: "Voetbaltickets.nl", href: "/projects/visitfootball" },
  { name: "TrustedSeats", href: "/projects/visitfootball" },
  { name: "Tracefox", href: "/projects/tracefox" },
];
---

<section class="relative flex flex-col gap-10" aria-labelledby="hero-title">
  <!-- Subtle brand glow behind the hero (desktop only: on phones it would sit past the screen edge) -->
  <div
    class="pointer-events-none absolute -left-40 -top-44 hidden h-[420px] w-[420px] rounded-full opacity-70 blur-2xl md:block"
    style="background: radial-gradient(closest-side, rgba(99,102,241,0.14), transparent);"
    aria-hidden="true"
  >
  </div>

  <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
    <div class="flex flex-col gap-7">
      <p class="kicker">{h.eyebrow}</p>

      <h1
        id="hero-title"
        class="text-balance font-theme_bold text-[1.75rem] leading-tight tracking-tight text-head_text sm:text-4xl slg:text-[2.75rem] slg:leading-[1.12]"
      >
        {h.h1}
      </h1>

      <p class="max-w-2xl text-base leading-relaxed slg:text-lg slg:leading-relaxed" set:html={h.leadHtml} />

      <div class="flex flex-wrap items-center gap-3">
        <ActionButton link={CONTACT.bookingUrl} variant="primary" event="book_call_click" eventLabel="hero">
          <Icon name="calendar" size={18} />{h.ctaPrimary}
        </ActionButton>
        <ActionButton link={localizePath("/projects", locale)} event="case_studies_click" eventLabel="hero">
          {h.ctaSecondary} <Icon name="arrow-right" size={18} />
        </ActionButton>
      </div>
    </div>

    <!-- Recruiter snapshot: who, where, since when, and the resume one click away. -->
    <div class="flex flex-col gap-5 rounded-lg border border-border_sm bg-item_back p-6 lg:mt-12">
      <h2 id="glance-title" class="kicker">{h.glance.heading}</h2>
      <dl class="flex flex-col gap-4">
        {
          h.glance.rows.map((r) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-t border-border_sm pt-4 first:border-0 first:pt-0">
              <dt class="font-theme text-xs uppercase leading-6 tracking-wider text-p_text">{r.label}</dt>
              <dd class="flex flex-col">
                <span class="font-theme_bold text-sm text-head_text">{r.value}</span>
                <span class="text-sm text-p_text">{r.sub}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <a
        href={t.resumeHref}
        data-event="resume_click"
        data-event-label="hero_card"
        class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-link_border bg-btn_back px-4 py-3 font-theme_bold text-sm text-btn_text transition-colors hover:bg-item_hover_back"
      >
        {h.glance.resume}
      </a>
      <a
        href={SITE.resumePdf}
        download
        data-event="resume_pdf_download"
        data-event-label="hero_card"
        class="-mt-2 inline-flex items-center justify-center gap-1.5 text-sm text-link_text_hover underline-offset-4 hover:underline"
      >
        <Icon name="download" size={16} />{h.glance.pdf}
      </a>
      <ul class="-mx-2 -my-1 flex items-center justify-center gap-1" aria-label={locale === "fr" ? "Profils" : "Profiles"}>
        {
          profiles.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="me noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-2 text-sm text-p_text transition-colors hover:bg-border_sm hover:text-head_text"
              >
                <Icon name={s.icon} size={16} />
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="flex flex-col gap-3 border-t border-border_sm pt-6">
    <p class="font-theme text-xs uppercase tracking-widest text-p_text">{h.platforms}</p>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {
        platforms.map((pl) => (
          <li>
            <a
              href={localizePath(pl.href, locale)}
              data-event="case_study_click"
              data-event-label={`hero_platform:${pl.name}`}
              class="font-theme_bold text-base text-action_text transition-colors hover:text-link_text_hover slg:text-lg"
            >
              {pl.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
