---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image?: ImageMetadata;
  title: string;
  /** Describes the screenshot; falls back to "<title> screenshot". */
  alt?: string;
  /** Aspect / sizing utility classes for the frame. */
  class?: string;
  /** Load immediately (use for the largest image above the fold). */
  eager?: boolean;
  sizes?: string;
}
const {
  image,
  title,
  alt,
  class: className = "aspect-video",
  eager = false,
  sizes = "(max-width: 978px) 100vw, 50vw",
} = Astro.props;
---

{
  image ? (
    <div class:list={["w-full overflow-hidden rounded-lg border border-border_sm bg-item_back", className]}>
      <Image
        src={image}
        alt={alt ?? `${title} screenshot`}
        widths={[400, 800, 1200]}
        sizes={sizes}
        class="h-full w-full object-cover object-top"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    </div>
  ) : (
    <div
      class:list={[
        "relative flex w-full items-center justify-center overflow-hidden rounded-lg border border-border_sm bg-item_back",
        className,
      ]}
      aria-hidden="true"
    >
      <div class="absolute inset-x-0 top-0 h-1 bg-topbar opacity-80" />
      <span class="px-6 text-center font-theme_bold text-xl text-head_text/80 slg:text-2xl">{title}</span>
    </div>
  )
}
