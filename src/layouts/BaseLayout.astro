---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import monoLisaBold from "../assets/fonts/MonoLisa-Bold.woff2";
import monoLisaRegular from "../assets/fonts/MonoLisa-Regular.woff2";
import { getLocale, alternates, ui } from "../i18n";
import TheNavbar from "../components/TheNavbar.astro";
import Footer from "../components/Footer.astro";
import { SITE, SOCIALS, LINKS } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  noindex?: boolean;
  /**
   * hreflang pair for pages outside the static TRANSLATED list (e.g. case
   * studies with a French version). `null` forces no alternates.
   */
  alternate?: { en: string; fr: string } | null;
}

const {
  title,
  description = SITE.description,
  image = "/og.png",
  imageAlt = `${SITE.name}, ${SITE.role}`,
  article = false,
  noindex = false,
  alternate,
} = Astro.props;

const locale = getLocale(Astro.url);
const t = ui[locale];
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
// Keep the trailing slash so canonical matches the sitemap URLs exactly.
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const alt = alternate === undefined ? alternates(Astro.url.pathname) : alternate;

// One stable entity graph on every page; @ids let other pages (About,
// case studies) refer to the same Person instead of redefining it.
const personId = `${SITE.url}/#person`;
const siteLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      inLanguage: ["en", "fr"],
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: SITE.name,
      givenName: "Hassan",
      familyName: "Tahrioui",
      jobTitle: SITE.role,
      description: ui.en.meta.home.description,
      url: `${SITE.url}/`,
      email: `mailto:${SITE.email}`,
      address: { "@type": "PostalAddress", addressCountry: "MA" },
      knowsLanguage: ["ar", "en", "fr"],
      sameAs: SOCIALS.map((s) => s.url),
      knowsAbout: [
        "Technical leadership",
        "Software architecture",
        "Full-stack development",
        "Laravel",
        "PHP",
        "Next.js",
        "React",
        "Vue.js",
        "Nuxt",
        "TypeScript",
        "Node.js",
        "Strapi",
        "PostgreSQL",
        "Redis",
        "Payment integration",
        "Multi-brand platforms",
        "Internationalization",
        "Technical SEO",
        "DevOps",
      ],
    },
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#tracefox`,
      name: "Tracefox",
      url: LINKS.tracefox,
      description: "Automated checkout testing for ecommerce stores and agencies.",
      founder: { "@id": personId },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#4F46E5" />
    <meta name="theme-color" content="#202026" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Mono faces set headings and above-the-fold labels; preloading both
         avoids a swap shift (body text is system sans and needs no download). -->
    <link rel="preload" href={monoLisaBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLisaRegular} as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={SITE.name} />
    {
      alt && !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alt.en, SITE.url).href} />
          <link rel="alternate" hreflang="fr" href={new URL(alt.fr, SITE.url).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.en, SITE.url).href} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    {alt && <meta property="og:locale:alternate" content={locale === "fr" ? "en_US" : "fr_FR"} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {image === "/og.png" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

    <ViewTransitions />

    <slot name="head" />

    {
      SITE.ga && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga}`} />
          <script is:inline define:vars={{ ga: SITE.ga }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag("js", new Date());
            gtag("config", ga);

            // Extra page_views on view-transition (soft) navigations.
            document.addEventListener("astro:page-load", function () {
              if (window.__gaFirstLoad) {
                gtag("event", "page_view", {
                  page_location: location.href,
                  page_title: document.title,
                });
              } else {
                window.__gaFirstLoad = true;
              }
            });

            // Conversion click events. Elements can name their own event with
            // data-event="..."; outbound contact links are tracked by URL.
            document.addEventListener("click", function (e) {
              var el = e.target && e.target.closest ? e.target.closest("[data-event], a[href]") : null;
              if (!el) return;
              var params = { page_path: location.pathname };
              if (el.dataset && el.dataset.event) {
                if (el.dataset.eventLabel) params.label = el.dataset.eventLabel;
                gtag("event", el.dataset.event, params);
                return;
              }
              var h = el.href || "";
              if (h.indexOf("calendly.com") > -1) gtag("event", "book_call_click", params);
              else if (h.indexOf("wa.me") > -1) gtag("event", "whatsapp_click", params);
              else if (h.indexOf("mailto:") === 0) gtag("event", "email_click", params);
              else if (h.indexOf("upwork.com") > -1) gtag("event", "upwork_click", params);
              else if (h.indexOf("linkedin.com") > -1) gtag("event", "linkedin_click", params);
              else if (h.indexOf("github.com") > -1) gtag("event", "github_click", params);
            });
          </script>
        </>
      )
    }

    <!-- Scroll reveal: tags below-the-fold blocks after load so nothing is
         hidden without JS; re-runs after each view transition. -->
    <script is:inline>
      (function () {
        function initReveal() {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          if (!("IntersectionObserver" in window)) return;
          var blocks = document.querySelectorAll("main > :first-child > *");
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add("revealed");
                  io.unobserve(en.target);
                }
              });
            },
            { threshold: 0.06 }
          );
          blocks.forEach(function (el) {
            if (el.classList.contains("reveal-init")) return;
            if (el.getBoundingClientRect().top > window.innerHeight * 0.92) {
              el.classList.add("reveal-init");
              io.observe(el);
            }
          });
        }
        document.addEventListener("astro:page-load", initReveal);
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-btn_back focus:px-4 focus:py-2 focus:text-btn_text"
    >
      {t.skip}
    </a>
    <TheNavbar alternate={alt} />
    <main
      id="main"
      class="mx-auto mb-24 mt-20 max-w-screen-lg px-6 pb-28 sm:mb-20 sm:mt-28 sm:px-12 sm:pb-24 slg:px-20 lg:mt-36"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
